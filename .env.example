# For docker-compose.yml (production-like stack). Copy to .env and fill in.
POSTGRES_PASSWORD=change-me
# node -e "console.log(crypto.randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me
# Public URL the app is reached at (used in invite links)
WEB_URL=http://localhost:8080
# Cookies are Secure by default; set false only when serving plain HTTP
# (e.g. LAN testing without TLS)
COOKIE_SECURE=true
# Optional. Firebase service-account JSON on one line; enables push
# notifications to the worker app. Leave empty to disable push.
FIREBASE_SERVICE_ACCOUNT=
# Optional. Extra origins allowed to call the API cross-origin, comma-separated.
# The web app and the worker app don't need this.
CORS_ORIGINS=
