# Copy to .env for local development (postgres from docker-compose.dev.yml).
# 127.0.0.1, not localhost: Node may resolve localhost to ::1, which some
# Docker port forwards (e.g. WSL2) don't listen on. Change the port here if
# you started the database with DOMAR_DB_PORT. E2e tests use the same server
# with a separate domar_test database.
DATABASE_URL="postgresql://domar:domar@127.0.0.1:5432/domar?schema=public"
PORT=3001
UPLOADS_DIR=./uploads
# Generate a long random string, e.g.: node -e "console.log(crypto.randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me

