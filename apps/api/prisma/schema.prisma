generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERVISOR
  WORKER
  OWNER
}

enum Skill {
  CLEANING
  REPAIR
  ELECTRICAL
  PLUMBING
  GENERAL
}

enum JobType {
  CLEANING
  REPAIR
  ELECTRICAL
  PLUMBING
  INSPECTION
  OTHER
}

enum JobStatus {
  DRAFT
  OPEN // reserved for the future claim-pool, unused in v1 flows
  ASSIGNED
  ACCEPTED
  DECLINED
  IN_PROGRESS
  DONE
  VERIFIED
  CANCELLED
}

enum JobPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ActivityType {
  CREATED
  STATUS_CHANGED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         Role
  skills       Skill[]  @default([])
  locale       String   @default("en")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens  RefreshToken[]
  properties     Property[]     @relation("PropertyOwner")
  assignedJobs   Job[]          @relation("JobWorker")
  createdJobs    Job[]          @relation("JobCreator")
  uploadedPhotos JobPhoto[]
  comments       JobComment[]
  activityEvents ActivityEvent[]
}

model Property {
  id          String   @id @default(uuid())
  name        String
  address     String
  lat         Float?
  lng         Float?
  accessNotes String?
  ownerId     String?
  owner       User?    @relation("PropertyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jobs              Job[]
  bookings          Booking[]
  checklistTemplate ChecklistTemplate?

  @@index([ownerId])
}

model ChecklistTemplate {
  id         String   @id @default(uuid())
  propertyId String   @unique
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  items      ChecklistTemplateItem[]
  updatedAt  DateTime @updatedAt
}

model ChecklistTemplateItem {
  id            String  @id @default(uuid())
  templateId    String
  template      ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  text          String
  photoRequired Boolean @default(false)
  sortOrder     Int     @default(0)

  @@index([templateId])
}

enum PhotoKind {
  BEFORE
  AFTER
  ISSUE
}

enum CommentVisibility {
  INTERNAL // supervisor <-> worker only
  SHARED // visible to the property owner too
}

model Booking {
  id            String   @id @default(uuid())
  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  /// When the current guest leaves (start of the turnover window).
  checkoutAt    DateTime
  /// When the next guest arrives, if known.
  checkinAt     DateTime?
  guestNote     String?
  /// The turnover cleaning created for this gap, once the supervisor acts.
  turnoverJobId String?  @unique
  turnoverJob   Job?     @relation(fields: [turnoverJobId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([propertyId, checkoutAt])
}

model JobComment {
  id         String            @id @default(uuid())
  jobId      String
  job        Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body       String
  visibility CommentVisibility @default(INTERNAL)
  createdAt  DateTime          @default(now())

  @@index([jobId, createdAt])
}

model ChecklistItem {
  id            String  @id @default(uuid())
  jobId         String
  job           Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  text          String
  photoRequired Boolean @default(false)
  done          Boolean @default(false)
  sortOrder     Int     @default(0)

  photos JobPhoto[]

  @@index([jobId])
}

model JobPhoto {
  id              String     @id @default(uuid())
  jobId           String
  job             Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  kind            PhotoKind
  /// Randomized stored filename (uuid + extension), never client-supplied.
  filename        String     @unique
  mimeType        String
  sizeBytes       Int
  caption         String?
  uploadedById    String?
  uploadedBy      User?      @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  checklistItemId String?
  checklistItem   ChecklistItem? @relation(fields: [checklistItemId], references: [id], onDelete: SetNull)
  createdAt       DateTime   @default(now())

  @@index([jobId])
}

model Job {
  id               String      @id @default(uuid())
  propertyId       String
  property         Property    @relation(fields: [propertyId], references: [id])
  type             JobType
  title            String
  description      String?
  status           JobStatus   @default(DRAFT)
  priority         JobPriority @default(NORMAL)
  scheduledStart   DateTime
  scheduledEnd     DateTime
  assignedWorkerId String?
  assignedWorker   User?       @relation("JobWorker", fields: [assignedWorkerId], references: [id], onDelete: SetNull)
  createdById      String?
  createdBy        User?       @relation("JobCreator", fields: [createdById], references: [id], onDelete: SetNull)
  /// Reason for the latest decline/reopen/cancel, surfaced to the supervisor.
  statusReason     String?
  workerNotes      String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  checklistItems ChecklistItem[]
  photos         JobPhoto[]
  comments       JobComment[]
  activityEvents ActivityEvent[]
  booking        Booking?

  @@index([propertyId])
  @@index([assignedWorkerId, scheduledStart])
  @@index([status])
  @@index([scheduledStart])
}

model ActivityEvent {
  id         String       @id @default(uuid())
  jobId      String
  job        Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  type       ActivityType
  fromStatus JobStatus?
  toStatus   JobStatus?
  reason     String?
  createdAt  DateTime     @default(now())

  @@index([createdAt])
  @@index([jobId, createdAt])
}

model Invite {
  id          String    @id @default(uuid())
  email       String
  role        Role
  skills      Skill[]   @default([])
  tokenHash   String    @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  invitedById String?
  createdAt   DateTime  @default(now())

  @@index([email])
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}
