generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERVISOR
  WORKER
  OWNER
}

enum CompanyStatus {
  ACTIVE // staff can log in and operate normally
  SUSPENDED // login blocked, sessions cannot refresh (e.g. non-payment)
}

/// A tenant: a property-care company. All operational data is scoped to a Company.
model Company {
  id              String        @id @default(uuid())
  name            String
  status          CompanyStatus @default(ACTIVE)
  /// Free-text plan label set by a platform admin (no self-serve tiers in MVP).
  plan            String?
  /// License cap: max active SUPERVISOR+WORKER users. Owners are not counted.
  maxSeats        Int
  /// Monthly fee in minor units; invoiced offline (no payment processing in MVP).
  monthlyFeeCents Int           @default(0)
  /// Account-owner (initially the first supervisor). Transferable; recoverable by a platform admin.
  /// Nullable to break the create-order chicken/egg (company → supervisor → set owner).
  ownerUserId     String?       @unique
  owner           User?         @relation("CompanyOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  /// Self-relation for future parent-company hierarchy. Schema hook only — no traversal behavior yet.
  parentCompanyId String?
  parent          Company?      @relation("CompanyHierarchy", fields: [parentCompanyId], references: [id], onDelete: SetNull)
  children        Company[]     @relation("CompanyHierarchy")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  users         User[]         @relation("CompanyMembers")
  properties    Property[]
  jobs          Job[]
  bills         Bill[]
  billLineItems BillLineItem[]
  invites       Invite[]
  bookings      Booking[]
  bids          Bid[]
  refreshTokens RefreshToken[]
  deviceTokens  DeviceToken[]

  @@index([parentCompanyId])
}

enum Skill {
  CLEANING
  REPAIR
  ELECTRICAL
  PLUMBING
  GARDENING
  GENERAL
}

enum JobType {
  CLEANING
  REPAIR
  ELECTRICAL
  PLUMBING
  GARDENING
  INSPECTION
  OTHER
}

enum JobStatus {
  DRAFT
  OPEN // reserved for the future claim-pool, unused in v1 flows
  ASSIGNED
  ACCEPTED
  DECLINED
  IN_PROGRESS
  DONE
  VERIFIED
  CANCELLED
}

enum JobPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ActivityType {
  CREATED
  STATUS_CHANGED
}

enum PriceType {
  FIXED // priceCents is the total net price
  HOURLY // priceCents is the net rate per hour
  NEGOTIABLE // open for bidding (Phase 2)
}

enum BidStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum BillStatus {
  DRAFT // supervisor assembling; invisible to owner
  CONFIRMED // issued/locked; visible to owner, PDF downloadable
}

enum BillLineItemKind {
  JOB // auto-derived worker/job cost; carries jobId
  ADDITIONAL // manual: management, organization, materials, etc.
}

model Bid {
  id          String    @id @default(uuid())
  jobId       String
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  workerId    String
  worker      User      @relation("WorkerBids", fields: [workerId], references: [id], onDelete: Cascade)
  /// Denormalized tenant (→ Job → companyId); accessed by bare id, so scoped directly.
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  priceType   PriceType // FIXED or HOURLY proposal
  /// Total (FIXED) or per-hour rate (HOURLY), in the job's currency (minor units).
  amountCents Int
  message     String?
  status      BidStatus @default(PENDING)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([jobId, workerId])
  @@index([jobId])
  @@index([companyId])
}

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  passwordHash    String
  name            String
  phone           String?
  role            Role
  skills          Skill[]  @default([])
  locale          String   @default("en")
  isActive        Boolean  @default(true)
  avatarFilename  String?
  /// Tenant. Nullable: platform admins belong to no company.
  companyId       String?
  company         Company? @relation("CompanyMembers", fields: [companyId], references: [id], onDelete: Cascade)
  /// Global super-admin above all tenants; has no companyId and bypasses tenant scoping.
  isPlatformAdmin Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  /// Back-relation: companies for which this user is the account-owner.
  ownedCompany    Company?        @relation("CompanyOwner")
  refreshTokens   RefreshToken[]
  deviceTokens    DeviceToken[]
  properties      Property[]      @relation("PropertyOwner")
  assignedJobs    Job[]           @relation("JobWorker")
  createdJobs     Job[]           @relation("JobCreator")
  uploadedPhotos  JobPhoto[]
  comments        JobComment[]
  activityEvents  ActivityEvent[]
  ratingsReceived JobRating[]     @relation("RatingsReceived")
  ratingsGiven    JobRating[]     @relation("RatingsGiven")
  bids            Bid[]           @relation("WorkerBids")
  createdBills    Bill[]          @relation("BillCreator")

  @@index([companyId, role])
}

model Property {
  id          String   @id @default(uuid())
  name        String
  address     String
  lat         Float?
  lng         Float?
  accessNotes String?
  ownerId     String?
  owner       User?    @relation("PropertyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jobs              Job[]
  bookings          Booking[]
  checklistTemplate ChecklistTemplate?
  bills             Bill[]

  @@index([ownerId])
  @@index([companyId])
}

model ChecklistTemplate {
  id         String                  @id @default(uuid())
  propertyId String                  @unique
  property   Property                @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  items      ChecklistTemplateItem[]
  updatedAt  DateTime                @updatedAt
}

model ChecklistTemplateItem {
  id            String            @id @default(uuid())
  templateId    String
  template      ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  text          String
  photoRequired Boolean           @default(false)
  sortOrder     Int               @default(0)

  @@index([templateId])
}

enum PhotoKind {
  BEFORE
  AFTER
  ISSUE
}

enum CommentVisibility {
  INTERNAL // supervisor <-> worker only
  SHARED // visible to the property owner too
}

model Booking {
  id            String    @id @default(uuid())
  propertyId    String
  property      Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// When the current guest leaves (start of the turnover window).
  checkoutAt    DateTime
  /// When the next guest arrives, if known.
  checkinAt     DateTime?
  guestNote     String?
  /// The turnover cleaning created for this gap, once the supervisor acts.
  turnoverJobId String?   @unique
  turnoverJob   Job?      @relation(fields: [turnoverJobId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([propertyId, checkoutAt])
  @@index([companyId])
}

model JobComment {
  id         String            @id @default(uuid())
  jobId      String
  job        Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body       String
  visibility CommentVisibility @default(INTERNAL)
  createdAt  DateTime          @default(now())

  @@index([jobId, createdAt])
}

model JobRating {
  id        String   @id @default(uuid())
  jobId     String   @unique
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  /// Denormalized for fast per-worker aggregation on the supervisor view.
  workerId  String
  worker    User     @relation("RatingsReceived", fields: [workerId], references: [id], onDelete: Cascade)
  /// The owner who gave the rating.
  ratedById String
  ratedBy   User     @relation("RatingsGiven", fields: [ratedById], references: [id], onDelete: Cascade)
  score     Int // 1–5, validated in the DTO
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workerId])
}

model ChecklistItem {
  id            String  @id @default(uuid())
  jobId         String
  job           Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  text          String
  photoRequired Boolean @default(false)
  done          Boolean @default(false)
  sortOrder     Int     @default(0)

  photos JobPhoto[]

  @@index([jobId])
}

model JobPhoto {
  id              String         @id @default(uuid())
  jobId           String
  job             Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  kind            PhotoKind
  /// Randomized stored filename (uuid + extension), never client-supplied.
  filename        String         @unique
  mimeType        String
  sizeBytes       Int
  caption         String?
  uploadedById    String?
  uploadedBy      User?          @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  checklistItemId String?
  checklistItem   ChecklistItem? @relation(fields: [checklistItemId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())

  @@index([jobId])
}

model Job {
  id               String      @id @default(uuid())
  propertyId       String
  property         Property    @relation(fields: [propertyId], references: [id])
  /// Denormalized tenant (Job → Property → companyId) for direct scoping + fast filters.
  companyId        String
  company          Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type             JobType
  title            String
  description      String?
  status           JobStatus   @default(DRAFT)
  priority         JobPriority @default(NORMAL)
  scheduledStart   DateTime
  scheduledEnd     DateTime
  assignedWorkerId String?
  assignedWorker   User?       @relation("JobWorker", fields: [assignedWorkerId], references: [id], onDelete: SetNull)
  createdById      String?
  createdBy        User?       @relation("JobCreator", fields: [createdById], references: [id], onDelete: SetNull)
  /// Reason for the latest decline/reopen/cancel, surfaced to the supervisor.
  statusReason     String?
  workerNotes      String?
  /// Pricing (net, no tax). null priceType = no price set.
  priceType        PriceType?
  /// Total (FIXED) or per-hour rate (HOURLY), in minor units (cents).
  priceCents       Int?
  currency         String      @default("EUR")
  /// Optional supervisor estimate, HOURLY only.
  estimatedHours   Float?
  /// Worker-entered actual hours at finish, HOURLY only.
  spentHours       Float?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  checklistItems ChecklistItem[]
  photos         JobPhoto[]
  comments       JobComment[]
  activityEvents ActivityEvent[]
  booking        Booking?
  rating         JobRating?
  bids           Bid[]
  billLineItems  BillLineItem[]

  @@index([propertyId])
  @@index([assignedWorkerId, scheduledStart])
  @@index([status])
  @@index([scheduledStart])
  @@index([companyId, status])
}

model ActivityEvent {
  id         String       @id @default(uuid())
  jobId      String
  job        Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  type       ActivityType
  fromStatus JobStatus?
  toStatus   JobStatus?
  reason     String?
  createdAt  DateTime     @default(now())

  @@index([createdAt])
  @@index([jobId, createdAt])
}

model Invite {
  id          String    @id @default(uuid())
  email       String
  role        Role
  skills      Skill[]   @default([])
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  invitedById String?
  createdAt   DateTime  @default(now())

  @@index([email])
  @@index([companyId])
}

model Bill {
  id          String     @id @default(uuid())
  propertyId  String
  property    Property   @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  companyId   String
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  status      BillStatus @default(DRAFT)
  /// Single currency for the whole bill (ISO 4217). All line items must match.
  currency    String     @default("EUR")
  /// Optional VAT rate in basis points (1900 = 19%). null = no tax line.
  taxRateBps  Int?
  /// Free-text invoice notes shown on the PDF (payment terms, etc.).
  notes       String?
  /// Human-facing reference, assigned at confirm time, e.g. INV-2026-0007.
  number      String?    @unique
  createdById String?
  createdBy   User?      @relation("BillCreator", fields: [createdById], references: [id], onDelete: SetNull)
  confirmedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  lineItems BillLineItem[]

  @@index([propertyId])
  @@index([status])
  @@index([companyId])
}

model BillLineItem {
  id              String           @id @default(uuid())
  billId          String
  bill            Bill             @relation(fields: [billId], references: [id], onDelete: Cascade)
  /// Denormalized tenant (→ Bill → companyId); accessed by bare id, so scoped directly.
  companyId       String
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind            BillLineItemKind
  /// Set when kind = JOB. SetNull so deleting a job never corrupts a confirmed bill.
  jobId           String?
  job             Job?             @relation(fields: [jobId], references: [id], onDelete: SetNull)
  /// Snapshot of the description at add-time (job title or manual label).
  label           String
  /// Quantity in hundredths (100 = 1.00 unit / 1 hr). FIXED job = 100.
  quantity        Int              @default(100)
  /// Net unit amount in minor units. Line total = round(unitAmountCents * quantity / 100).
  unitAmountCents Int
  sortOrder       Int              @default(0)
  createdAt       DateTime         @default(now())

  @@index([billId])
  @@index([jobId])
  @@index([companyId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Tenant of the owning user (null for platform admins). Enables bulk-revoke on suspend.
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([companyId])
}

model DeviceToken {
  id         String   @id @default(uuid())
  /// FCM (Android) / APNs-via-FCM (iOS) registration token.
  token      String   @unique
  platform   String
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Tenant of the owning user (null for platform admins).
  companyId  String?
  company    Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @updatedAt

  @@index([userId])
  @@index([companyId])
}
