# Absolute base URL of the NestJS API the mobile app talks to.
# Dev on a device/emulator: use your machine's LAN IP, not localhost.
#   iOS simulator can use http://localhost:3001
#   Android emulator reaches the host at http://10.0.2.2:3001
#   Physical device: http://<your-LAN-ip>:3001 (or an HTTPS staging URL)
VITE_API_BASE=http://localhost:3001

# Push requires a Firebase project (google-services.json + APNs). Off by default.
VITE_PUSH_ENABLED=false
